Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /MovingObjects1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 80; 80; 80
      Alpha: 0.3
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: Husky
      Enabled: true
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/PointCloud2
      Name: World (static context)
      Enabled: true
      Topic:
        Value: /velodyne_points
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Alpha: 0.35
      Color: 170; 170; 170
      Color Transformer: FlatColor
      Decay Time: 0
      Position Transformer: XYZ
      Selectable: false
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Name: MovingObjects
      Enabled: true
      Topic:
        Value: /sparseunet4d_mos/points_moving
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Spheres
      Size (m): 0.3
      Alpha: 1
      Color: 0; 255; 0
      Color Transformer: FlatColor
      Decay Time: 0.4
      Position Transformer: XYZ
      Selectable: false
      Use Fixed Frame: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: odom
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 25
      Pitch: 0.55
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Near Clip Distance: 0.01
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1400
