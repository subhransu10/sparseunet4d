Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Raw LiDAR (10 Hz)1
        - /Moving points (MOS)1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Color: 80; 80; 80
      Alpha: 0.3
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/PointCloud2
      Name: Delayed LiDAR (10 Hz)
      Enabled: true
      Topic:
        Value: /velodyne_points_delayed
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Size (m): 0.03
      Alpha: 0.4
      Color: 160; 160; 160
      Color Transformer: FlatColor
      Decay Time: 0
      Position Transformer: XYZ
      Selectable: false
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Moving points (MOS)
      Enabled: true
      Topic:
        Value: /sparseunet4d_mos/points_moving
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Spheres
      Size (Pixels): 5
      Size (m): 0.1
      Alpha: 1
      Color: 255; 0; 0
      Color Transformer: FlatColor
      Decay Time: 0.7
      Position Transformer: XYZ
      Selectable: true
      Use Fixed Frame: true
  Enabled: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 22
      Pitch: 0.55
      Yaw: 0.78
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1440
