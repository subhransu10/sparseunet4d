From c2af62c7d8c981974f651b1c804b5b1f6638f0bd Mon Sep 17 00:00:00 2001
From: subhransu10 <subhransusouravp@gmail.com>
Date: Wed, 12 Aug 2026 02:06:15 +0200
Subject: [PATCH] Add balanced point-instance fine-tuning probe

---
 configs/dual_v17_point_instance_ft.yaml | 54 +++++++++++++++++++++++++
 1 file changed, 54 insertions(+)
 create mode 100644 configs/dual_v17_point_instance_ft.yaml

diff --git a/configs/dual_v17_point_instance_ft.yaml b/configs/dual_v17_point_instance_ft.yaml
new file mode 100644
index 0000000..f9cc8ad
--- /dev/null
+++ b/configs/dual_v17_point_instance_ft.yaml
@@ -0,0 +1,54 @@
+# Combine the two mechanisms that are independently useful and complementary:
+# v16's point-density-aware objective and v15's whole-instance seed pressure.
+# Warm-start from v16/best.pt.  The instance term is deliberately gentler than
+# v15 (0.10 vs 0.25) to retain v16's car precision/recall while recovering the
+# person and entirely-missed-instance gains seen in v15.
+dataset:
+  root: /mnt/d/Subhransu workspace/Dataset/my_kitti_dataset/dataset/sequences
+  semantic_yaml: /mnt/d/Subhransu workspace/Dataset/my_kitti_dataset/dataset/sequences/semantic-kitti.yaml
+  train_sequences: [0, 1, 2, 3, 4, 5, 6, 7, 9, 10]
+  val_sequences: [8]
+  n_frames: 5
+  frame_offsets: [1, 2, 4, 8]
+  voxel_size: 0.1
+  point_range: 51.2
+  residual_feats: true
+  res_clip: 3.0
+  augment: false
+  inject_bank: /home/suba/sparseunet4d/mover_bank.npy
+  inject_prob: 0.4
+  inject_max_n: 2
+  all_frame_labels: true
+pose:
+  mode: gt
+  rot_std_deg: 0.0
+  trans_std_m: 0.0
+  seed: 0
+train:
+  batch_size: 2
+  iters: 10000
+  lr: 0.00003
+  weight_decay: 0.0001
+  val_every: 1000
+  warmup_iters: 250
+  lr_schedule: cosine
+  checkpoint_metric: point
+  checkpoint_thresholds: [0.05, 0.10, 0.15, 0.20, 0.25, 0.30, 0.35, 0.40, 0.45, 0.50, 0.55, 0.60, 0.65, 0.70, 0.75, 0.80, 0.85, 0.90, 0.93, 0.95]
+loss:
+  motion_weight: 1.0
+  semantic_weight: 1.0
+  dice_weight: 1.0
+  moving_class_weight: 1.25
+  cluster_weight: 0.5
+  point_weight_exponent: 0.5
+  point_weight_cap: 8.0
+  instance_detection_weight: 0.10
+  instance_topk_fraction: 0.10
+model:
+  use_cluster: true
+  cluster_link: 2
+  cluster_min_size: 3
+  cluster_cross_frame: false
+  cluster_feature_fusion: true
+  dual_branch: true
+  app_ch: 1
-- 
