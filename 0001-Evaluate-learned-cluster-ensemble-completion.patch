+"""Evaluate learned-cluster completion on a two-model point-level ensemble.
+
+This is a realizable counterpart to the GT-instance oracle in
+``diagnose_errors.py``.  It uses only the cluster ids produced by checkpoint A,
+never GT instance ids.  A cluster-level score is pooled from the ensemble's
+voxel probabilities and propagated back to the cluster's reference points.
+All threshold statistics are accumulated per frame, keeping memory bounded.
+"""
+import argparse
+import os
+import sys
+
+import numpy as np
+import torch
+import yaml
+from torch.utils.data import DataLoader
+
+sys.path.insert(0, os.path.expanduser("~/sparseunet4d"))
+from experiments.ensemble_eval import (load_model, threshold_counts, to_st)
+from sparseunet4d.datasets import SemanticKITTI4D, me_collate
+
+
+DEFAULT_THRESHOLDS = [x / 100 for x in range(30, 91, 2)] + [0.53]
+MODES = ("point", "mean", "top25", "top10", "max", "learned")
+
+
+def pooled_scores(scores, cluster_ids, mode, learned=None):
+    """Return one score per cluster for nonnegative ``cluster_ids``."""
+    valid = cluster_ids >= 0
+    if not valid.any():
+        return np.zeros(0, np.float32)
+    ids = cluster_ids[valid]
+    vals = scores[valid]
+    n_cluster = int(ids.max()) + 1
+    if mode == "mean":
+        sums = np.bincount(ids, weights=vals, minlength=n_cluster)
+        counts = np.bincount(ids, minlength=n_cluster)
+        return (sums / np.maximum(counts, 1)).astype(np.float32)
+    if mode == "max":
+        out = np.full(n_cluster, -np.inf, np.float32)
+        np.maximum.at(out, ids, vals)
+        return out
+    if mode == "learned":
+        out = np.zeros(n_cluster, np.float32)
+        if learned is not None:
+            n = min(n_cluster, len(learned))
+            out[:n] = learned[:n]
+        return out
+
+    fraction = 0.25 if mode == "top25" else 0.10
+    order = np.argsort(ids, kind="stable")
+    ids_sorted, vals_sorted = ids[order], vals[order]
+    starts = np.r_[0, np.flatnonzero(np.diff(ids_sorted)) + 1]
+    ends = np.r_[starts[1:], len(ids_sorted)]
+    out = np.zeros(n_cluster, np.float32)
+    for start, end in zip(starts, ends):
+        group = vals_sorted[start:end]
+        k = max(1, int(np.ceil(len(group) * fraction)))
+        out[ids_sorted[start]] = np.partition(group, len(group) - k)[-k:].mean()
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--config", required=True)
+    ap.add_argument("--ckpt-a", required=True)
+    ap.add_argument("--ckpt-b", required=True)
+    ap.add_argument("--weight-a", type=float, default=0.5)
+    ap.add_argument("--thresholds", type=float, nargs="+",
+                    default=DEFAULT_THRESHOLDS)
+    args = ap.parse_args()
+    if not 0 <= args.weight_a <= 1:
+        raise ValueError("--weight-a must be in [0, 1]")
+
+    with open(args.config) as f:
+        cfg = yaml.safe_load(f)
+    cfg.setdefault("model", {})
+    d, p, m = cfg["dataset"], cfg["pose"], cfg["model"]
+    if not m.get("use_cluster", False):
+        raise ValueError("config must enable the learned cluster head")
+    dev = "cuda" if torch.cuda.is_available() else "cpu"
+    thresholds = np.asarray(sorted(set(args.thresholds)), dtype=np.float32)
+
+    ds = SemanticKITTI4D(
+        d["root"], d["val_sequences"], d["n_frames"], d["voxel_size"],
+        d["semantic_yaml"], "gt", 0.0, 0.0, p["seed"], d["point_range"],
+        residual_feats=d.get("residual_feats", True),
+        res_clip=d.get("res_clip", 3.0),
+        frame_offsets=d.get("frame_offsets"),
+        feat_rep=d.get("feat_rep", "label"),
+        residual_validity=d.get("residual_validity", False),
+        residual_all_frames=d.get("residual_all_frames", False),
+        return_point_map=True)
+    loader = DataLoader(ds, batch_size=1, shuffle=False, collate_fn=me_collate,
+                        num_workers=4)
+    ma = load_model(args.ckpt_a, d, m, dev)
+    mb = load_model(args.ckpt_b, d, m, dev)
+
+    tp = np.zeros((len(MODES), len(thresholds)), np.int64)
+    fp = np.zeros_like(tp)
+    total_pos = 0
+    w = np.float32(args.weight_a)
+    with torch.no_grad():
+        for bi, batch in enumerate(loader):
+            x = to_st(batch, dev)
+            oa, ob = ma(x), mb(x)
+            pva = torch.softmax(oa["motion_logits"], 1)[:, 1].cpu().numpy()
+            pvb = torch.softmax(ob["motion_logits"], 1)[:, 1].cpu().numpy()
+            voxel_score = w * pva + (1.0 - w) * pvb
+            cluster_ids = oa["cluster_row_id"].cpu().numpy()
+            learned = oa.get("cluster_logits")
+            learned = (torch.sigmoid(learned).cpu().numpy()
+                       if learned is not None else None)
+
+            rpv = batch["ref_point_voxel"].numpy()
+            gt = batch["ref_point_motion"].numpy()
+            valid = gt != -1
+            positive = gt[valid] == 1
+            total_pos += int(positive.sum())
+            point_score = voxel_score[rpv][valid]
+            point_cluster = cluster_ids[rpv][valid]
+
+            candidates = [point_score]
+            for mode in MODES[1:]:
+                cluster_score = pooled_scores(
+                    voxel_score, cluster_ids, mode, learned=learned)
+                adjusted = point_score.copy()
+                member = point_cluster >= 0
+                adjusted[member] = np.maximum(
+                    adjusted[member], cluster_score[point_cluster[member]])
+                candidates.append(adjusted)
+
+            for mi, scores in enumerate(candidates):
+                batch_tp, batch_fp = threshold_counts(
+                    scores, positive, thresholds)
+                tp[mi] += batch_tp
+                fp[mi] += batch_fp
+            if bi % 500 == 0:
+                print(f"  frame {bi}/{len(loader)}", flush=True)
+
+    print(f"\n=== learned-cluster ensemble, val seq {d['val_sequences']} ===")
+    print(f"ensemble: w(A)={args.weight_a:.2f}; A supplies cluster proposals")
+    print(f"{'pool':>10} {'best IoU':>9} {'@th':>6} {'Prec':>8} {'Rec':>8}")
+    rows = []
+    for mi, mode in enumerate(MODES):
+        fn = total_pos - tp[mi]
+        ious = tp[mi] / np.maximum(tp[mi] + fp[mi] + fn, 1)
+        ti = int(np.argmax(ious))
+        tpi, fpi, fni = int(tp[mi, ti]), int(fp[mi, ti]), int(fn[ti])
+        row = (float(ious[ti]), mode, float(thresholds[ti]),
+               tpi / max(tpi + fpi, 1), tpi / max(tpi + fni, 1))
+        rows.append(row)
+        print(f"{mode:>10} {row[0]:9.4f} {row[2]:6.2f} "
+              f"{row[3]:8.4f} {row[4]:8.4f}")
+    best = max(rows)
+    print(f"\nBEST: IoU={best[0]:.4f} pool={best[1]} threshold={best[2]:.2f} "
+          f"P={best[3]:.4f} R={best[4]:.4f}")
+
+
+if __name__ == "__main__":
+    main()
